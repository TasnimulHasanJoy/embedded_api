{
  "info": {
    "_postman_id": "5bd35264-feb6-4b8d-8939-c1ac1a4b11d5",
    "name": "Circadian Blinds API",
    "description": "Requests for the local Express API: ThingSpeak data, wake-up time, and blind/system status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get all ThingSpeak data",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/data",
          "host": ["{{baseUrl}}"],
          "path": ["api", "data"]
        }
      }
    },
    {
      "name": "Get current settings",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/settings",
          "host": ["{{baseUrl}}"],
          "path": ["api", "settings"]
        }
      }
    },
    {
      "name": "Set wake-up time",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"time\": \"07:00\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/wakeup-time",
          "host": ["{{baseUrl}}"],
          "path": ["api", "wakeup-time"]
        }
      }
    },
    {
      "name": "Set blind/system status",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"open\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "status"]
        }
      }
    }
  ]
}

